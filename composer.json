{
  "name": "anbarli/anbarli-rss-featured-image",
  "description": "Add WordPress featured images to RSS feeds as Media RSS media:content tags.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Gurkan Anbarli",
      "homepage": "https://anbarli.com.tr"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "lint": [
      "php -l anbarli-rss-featured-image.php",
      "php -l includes/class-anbarli-rss-featured-image.php"
    ],
    "phpcs": "phpcs",
    "check": [
      "@lint",
      "@phpcs"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
